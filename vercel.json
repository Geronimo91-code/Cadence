{
  "crons": [
    {
      "path": "/api/daily-notify",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/weekly-close",
      "schedule": "0 4 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}