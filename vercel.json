{
  "crons": [
    {
      "path": "/api/daily-notify",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/weekly-close",
      "schedule": "0 4 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/yosh.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Yosh.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 300,
      "includeFiles": "firestore.rules"
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://cadence-7f9d0.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://cadence-7f9d0.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
