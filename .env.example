# Server-side only — set these in Vercel → Project → Settings → Environment Variables
# Model providers — set one or both. Gemini is tried first (higher free daily limit), OpenRouter is the fallback.
GEMINI_API_KEY=            # aistudio.google.com → Get API key (free tier, no card)
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/free
FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}   # whole JSON on one line
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=some-long-random-string
