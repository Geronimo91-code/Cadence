rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function clubsOf(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.clubIds; }
    function memberDoc(clubId, uid) { return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(uid)); }
    function isMember(clubId) { return signedIn() && exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)); }
    function isCoach(clubId) { return isMember(clubId) && memberDoc(clubId, request.auth.uid).data.role == 'coach'; }
    // A coach of ANY club the user belongs to may read that user's training data (never nutrition or weights)
    function isCoachOfAnyClub(uid) {
      let ids = clubsOf(uid);
      return signedIn() && ids != null && ids.size() > 0 && (
        (ids.size() > 0 && isCoach(ids[0])) ||
        (ids.size() > 1 && isCoach(ids[1])) ||
        (ids.size() > 2 && isCoach(ids[2])) ||
        (ids.size() > 3 && isCoach(ids[3])) ||
        (ids.size() > 4 && isCoach(ids[4]))
      );
    }

    // usage/{uid} is written only by the server (Admin SDK); no client access on purpose
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /plans/{doc}   { allow read: if isOwner(uid) || isCoachOfAnyClub(uid); allow write: if isOwner(uid); }
      match /logs/{doc}    { allow read: if isOwner(uid) || isCoachOfAnyClub(uid); allow write: if isOwner(uid); }
      match /reviews/{doc} { allow read: if isOwner(uid) || isCoachOfAnyClub(uid); allow write: if isOwner(uid); }
      match /{document=**} { allow read, write: if isOwner(uid); }
    }

    match /clubs/{clubId} {
      // Club docs hold only name, sport, invite code and creator; readable by any signed-in user so people can join by code
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCoach(clubId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(clubId);
        // Join: create your own member doc, as a plain member, with the correct invite code
        allow create: if isOwner(uid)
          && request.resource.data.uid == uid
          && (request.resource.data.role == 'member' || get(/databases/$(database)/documents/clubs/$(clubId)).data.createdBy == uid)
          && request.resource.data.code == get(/databases/$(database)/documents/clubs/$(clubId)).data.inviteCode;
        // Members may change only their own visibility; coaches may change roles / remove people
        allow update: if (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'name']))
          || (isCoach(clubId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']));
        allow delete: if isOwner(uid) || isCoach(clubId);
      }
      match /activity/{id} {
        allow read: if isMember(clubId);
        allow create, update: if isMember(clubId) && request.resource.data.uid == request.auth.uid;
        allow delete: if isMember(clubId) && resource.data.uid == request.auth.uid;
      }
      match /teamSessions/{id} {
        allow read: if isMember(clubId);
        allow write: if false;  // written by the server only
      }
      match /notes/{uid} {
        allow read: if isCoach(clubId) || isOwner(uid);
        allow write: if isCoach(clubId);
      }
    }
  }
}
